{
  "version": 2,
  "env": {
    "CORS_ORIGIN": "http://localhost:3000,https://rkiza-pro.vercel.app"
  },
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.cjs": {
      "maxDuration": 30,
      "includeFiles": "api/dist/**"
    }
  }
}
