{
  "name": "rikaz-accounting-api",
  "version": "2.0.0",
  "description": "REST API منفصل لنظام ركاز المحاسبي",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "stop": "node scripts/stop-server.cjs",
    "build": "tsc && tsc-alias -p tsconfig.json",
    "vercel-build": "npm run build",
    "start:prod": "node dist/server.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "mysql2": "^3.22.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.19.3",
    "typescript": "^5"
  }
}
